<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>razor-nodeexport</AssemblyName>
    <RootNamespace>Razor.NodeExport</RootNamespace>
    <Description>
      Exportiert die VScript-Node-Registrierungen (NodeFactory) aus Razor.Core
      nach vscript-nodes.json (Doku-Website). Pro Node werden die echten Pins
      einer frisch erzeugten Instanz mit ausgegeben - die Referenz kann nicht
      luegen (D15).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Razor.Core\Razor.Core.csproj" />
  </ItemGroup>

</Project>
