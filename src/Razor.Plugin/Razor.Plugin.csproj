<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>UOSagas.Razor</AssemblyName>
    <!-- Version treibt die Anzeige im Launcher (0.* = Beta-State). -->
    <Version>0.5.0</Version>
    <RootNamespace>Razor.Plugin</RootNamespace>
    <Description>UOSagas-Razor Assistant-Plugin (IAssistantPlugin) fuer den Bootstrap-Host des UOSagas-Clients.</Description>
    <!-- Phase 3a: Der Bootstrap-Host laedt das Plugin per Assembly.LoadFrom aus
         dem Plugins-Ordner. Damit die Avalonia-Abhaengigkeiten dort mitliegen,
         muss der Build-Output ALLE NuGet-Assemblies enthalten. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Razor.Core\Razor.Core.csproj" />
    <ProjectReference Include="..\Razor.Avalonia\Razor.Avalonia.csproj" />
    <ProjectReference Include="..\..\external\AssistantApi\src\UOSagas.AssistantApi\UOSagas.AssistantApi.csproj" />
  </ItemGroup>

  <!-- Native Avalonia-Libs (Skia/HarfBuzz/ANGLE) neben die Managed-DLLs legen:
       P/Invoke-Probing sucht im Verzeichnis der aufrufenden Assembly, nicht in
       runtimes/win-x64/native (das Plugin wird nicht "gepublished"). -->
  <Target Name="CopyNativeRuntimeLibs" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <NativeWinLibs Include="$(OutputPath)runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeWinLibs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
